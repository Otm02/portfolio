---
import { ICONS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: cls } = Astro.props;
---

<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[name]} />
