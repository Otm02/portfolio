---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import Chrome from '../components/Chrome.astro';
import { getProfile } from '../lib/data';
import { getSiteData } from '../lib/palette';

interface Props {
  title: string;
  description: string;
  /** Path of the build-time Open Graph image, e.g. /og/home.png */
  og: string;
  ogAlt: string;
  type?: 'website' | 'article';
  home?: boolean;
  current?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description, og, ogAlt, type = 'website', home = false, current, jsonLd, noindex = false } = Astro.props;
const profile = await getProfile();
const siteData = await getSiteData();
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), site).href;
const ogUrl = new URL(og, site).href;
// Cloudflare Web Analytics site token. It isn't secret (it ships in every page), so it lives here;
// PUBLIC_CF_BEACON_TOKEN overrides it, and a pasted snippet works too. Production builds only.
const ANALYTICS_TOKEN = '4cb5fd94ebbd45a189280c2bd92ccfba';
const beacon = import.meta.env.PROD
  ? (import.meta.env.PUBLIC_CF_BEACON_TOKEN || ANALYTICS_TOKEN).match(/[0-9a-f]{32}/)?.[0]
  : undefined;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') d.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FCFCFC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0E10" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="spot" aria-hidden="true"></div>
    <TopBar name={profile.name} home={home} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!home && <Footer name={profile.name} lastUpdated={profile.lastUpdated} />}
    <Chrome data={siteData} />
    <script>
      import '../scripts/site.ts';
    </script>
    {beacon && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })} />}
  </body>
</html>
